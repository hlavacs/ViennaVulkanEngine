{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VVE_DEFAULT_VULKAN_ICD": "system"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "environment": {
        "PATH": "${sourceDir}/tools/shims;$penv{PATH}"
      }
    },
    {
      "name": "debug-windows",
      "displayName": "Debug (Windows)",
      "inherits": [
        "debug-base",
        "windows-base"
      ],
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "VVE_VCPKG_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Debug (Linux)",
      "inherits": "debug-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VVE_VCPKG_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "debug-macos",
      "displayName": "Debug (macOS)",
      "inherits": "debug-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VVE_DEFAULT_VULKAN_ICD": "moltenvk",
        "VVE_VCPKG_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "debug-macos-arm64-llvm",
      "displayName": "Debug (macOS arm64 LLVM)",
      "inherits": "debug-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "/opt/homebrew/opt/llvm/bin/clang-scan-deps",
        "CMAKE_CXX_MODULE_STD": "ON",
        "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/homebrew/opt/llvm/lib/c++/libc++.modules.json",
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "451f2fe2-a8a2-47c3-bc32-94786d8fc91b",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VVE_DEFAULT_VULKAN_ICD": "moltenvk",
        "VVE_VCPKG_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug-windows",
      "displayName": "Build Debug (Windows)",
      "configurePreset": "debug-windows",
      "environment": {
        "PATH": "${sourceDir}/tools/shims;$penv{PATH}"
      },
      "configuration": "Debug",
      "jobs": 16
    },
    {
      "name": "build-debug-linux",
      "displayName": "Build Debug (Linux)",
      "configurePreset": "debug-linux",
      "jobs": 16
    },
    {
      "name": "build-debug-macos",
      "displayName": "Build Debug (macOS)",
      "configurePreset": "debug-macos",
      "jobs": 16
    },
    {
      "name": "build-debug-macos-arm64-llvm",
      "displayName": "Build Debug (macOS arm64 LLVM)",
      "configurePreset": "debug-macos-arm64-llvm",
      "jobs": 16
    }
  ]
}
