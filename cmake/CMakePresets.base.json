{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VVE_DEFAULT_VULKAN_ICD": "system",
        "VVE_ENGINE_IMPLEMENTATION_NAMESPACE": "simple"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VVE_DEFAULT_VULKAN_ICD": "system",
        "VVE_ENGINE_IMPLEMENTATION_NAMESPACE": "simple"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "environment": {
        "PATH": "${sourceDir}/tools/shims;$penv{PATH}"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-18",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "/usr/bin/clang-scan-deps-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_CXX_STDLIB_MODULES_JSON": "/usr/lib/llvm-18/lib/libc++.modules.json"
      }
    },
    {
      "name": "debug-windows",
      "displayName": "Debug (Windows)",
      "inherits": [
        "debug-base",
        "windows-base"
      ],
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "VVE_VCPKG_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "release-windows",
      "displayName": "Release (Windows)",
      "inherits": [
        "release-base",
        "windows-base"
      ],
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "VVE_VCPKG_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Debug (Linux)",
      "inherits": [
        "debug-base",
        "linux-base"
      ],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VVE_VCPKG_TRIPLET": "x64-linux-llvm"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release (Linux)",
      "inherits": [
        "release-base",
        "linux-base"
      ],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VVE_VCPKG_TRIPLET": "x64-linux-llvm"
      }
    },
    {
      "name": "debug-macos",
      "displayName": "Debug (macOS)",
      "inherits": "debug-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos-arm64-homebrew-llvm.cmake",
        "VVE_DEFAULT_VULKAN_ICD": "kosmickrisp",
        "VVE_VCPKG_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "release-macos",
      "displayName": "Release (macOS)",
      "inherits": "release-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos-arm64-homebrew-llvm.cmake",
        "VVE_DEFAULT_VULKAN_ICD": "kosmickrisp",
        "VVE_VCPKG_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "debug-macos-arm64-llvm",
      "displayName": "Debug (macOS arm64 LLVM)",
      "inherits": "debug-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos-arm64-homebrew-llvm.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VVE_DEFAULT_VULKAN_ICD": "kosmickrisp",
        "VVE_VCPKG_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "release-macos-arm64-llvm",
      "displayName": "Release (macOS arm64 LLVM)",
      "inherits": "release-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos-arm64-homebrew-llvm.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VVE_DEFAULT_VULKAN_ICD": "kosmickrisp",
        "VVE_VCPKG_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug-windows",
      "displayName": "Build Debug (Windows)",
      "configurePreset": "debug-windows",
      "environment": {
        "PATH": "${sourceDir}/tools/shims;$penv{PATH}"
      },
      "configuration": "Debug",
      "jobs": 16
    },
    {
      "name": "build-release-windows",
      "displayName": "Build Release (Windows)",
      "configurePreset": "release-windows",
      "environment": {
        "PATH": "${sourceDir}/tools/shims;$penv{PATH}"
      },
      "configuration": "Release",
      "jobs": 16
    },
    {
      "name": "build-debug-linux",
      "displayName": "Build Debug (Linux)",
      "configurePreset": "debug-linux",
      "jobs": 16
    },
    {
      "name": "build-release-linux",
      "displayName": "Build Release (Linux)",
      "configurePreset": "release-linux",
      "jobs": 16
    },
    {
      "name": "build-debug-macos",
      "displayName": "Build Debug (macOS)",
      "configurePreset": "debug-macos",
      "jobs": 16
    },
    {
      "name": "build-release-macos",
      "displayName": "Build Release (macOS)",
      "configurePreset": "release-macos",
      "jobs": 16
    },
    {
      "name": "build-debug-macos-arm64-llvm",
      "displayName": "Build Debug (macOS arm64 LLVM)",
      "configurePreset": "debug-macos-arm64-llvm",
      "jobs": 16
    },
    {
      "name": "build-release-macos-arm64-llvm",
      "displayName": "Build Release (macOS arm64 LLVM)",
      "configurePreset": "release-macos-arm64-llvm",
      "jobs": 16
    }
  ]
}
