PROJECT_NAME           = "ViennaVulkanEngine"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@VVE_DOXYGEN_OUTPUT_DIRECTORY@"

INPUT                  = @VVE_DOXYGEN_INPUT@
RECURSIVE              = YES

FILE_PATTERNS          = *.h *.hpp *.c *.cc *.cpp *.ixx *.md
EXTENSION_MAPPING      = ixx=C++

USE_MDFILE_AS_MAINPAGE = README.md
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"

OPTIMIZE_OUTPUT_FOR_C  = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
