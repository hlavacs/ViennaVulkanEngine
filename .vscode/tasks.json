{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vcpkg Install",
            "type": "shell",
            "command": "vcpkg",
            "args": [
                "install",
                "--triplet",
                "x64-windows"
            ],
            "osx": {
                "args": [
                    "install",
                    "--triplet",
                    "arm64-osx"
                ]
            },
            "linux": {
                "args": [
                    "install",
                    "--triplet",
                    "x64-linux"
                ]
            },
            "windows": {
                "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command",
                    "$vcpkg = if ($env:VCPKG_ROOT -and (Test-Path (Join-Path $env:VCPKG_ROOT 'vcpkg.exe'))) { Join-Path $env:VCPKG_ROOT 'vcpkg.exe' } elseif (Test-Path 'C:\\vcpkg\\vcpkg.exe') { 'C:\\vcpkg\\vcpkg.exe' } else { 'vcpkg' }; & $vcpkg install --triplet x64-windows; exit $LASTEXITCODE"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "windows": {
                "args": [
                    "--preset",
                    "debug-windows"
                ]
            },
            "linux": {
                "args": [
                    "--preset",
                    "debug-linux"
                ]
            },
            "osx": {
                "args": [
                    "--preset",
                    "debug-macos-arm64-llvm"
                ]
            }
        },
        {
            "label": "Bootstrap Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-windows"
                ]
            },
            "linux": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-linux"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-macos-arm64-llvm"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "ctest",
            "dependsOn": [
                "Build Debug"
            ],
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/debug-windows",
                "-C",
                "Debug",
                "--output-on-failure"
            ],
            "linux": {
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/debug-linux",
                    "--output-on-failure"
                ]
            },
            "osx": {
                "command": "/usr/bin/env",
                "args": [
                    "VK_ICD_FILENAMES=${workspaceFolder}/build/debug-macos-arm64-llvm/vulkan/icd.d/MoltenVK_icd.json",
                    "ctest",
                    "--test-dir",
                    "${workspaceFolder}/build/debug-macos-arm64-llvm",
                    "--output-on-failure"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run World Tests",
            "type": "shell",
            "command": "ctest",
            "dependsOn": [
                "Build Debug"
            ],
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/debug-windows",
                "-C",
                "Debug",
                "--output-on-failure",
                "-R",
                "^WorldTests$"
            ],
            "linux": {
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/debug-linux",
                    "--output-on-failure",
                    "-R",
                    "^WorldTests$"
                ]
            },
            "osx": {
                "command": "/usr/bin/env",
                "args": [
                    "VK_ICD_FILENAMES=${workspaceFolder}/build/debug-macos-arm64-llvm/vulkan/icd.d/MoltenVK_icd.json",
                    "ctest",
                    "--test-dir",
                    "${workspaceFolder}/build/debug-macos-arm64-llvm",
                    "--output-on-failure",
                    "-R",
                    "^WorldTests$"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build And Test Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Run Unit Tests"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
