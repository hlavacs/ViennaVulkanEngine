{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vcpkg Install",
            "type": "shell",
            "command": "vcpkg",
            "args": [
                "install"
            ],
            "osx": {
                "args": [
                    "install",
                    "--triplet",
                    "arm64-osx"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Debug",
            "type": "shell",
            "command": "cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "windows": {
                "args": [
                    "--preset",
                    "debug-windows"
                ]
            },
            "linux": {
                "args": [
                    "--preset",
                    "debug-linux"
                ]
            },
            "osx": {
                "args": [
                    "--preset",
                    "debug-macos-arm64-llvm"
                ]
            }
        },
        {
            "label": "Bootstrap Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Vcpkg Install",
                "Configure Debug",
                "Build Debug"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-windows"
                ]
            },
            "linux": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-linux"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-macos-arm64-llvm"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Vcpkg Install macOS x64 LLVM",
            "type": "shell",
            "command": "vcpkg",
            "args": [
                "install",
                "--triplet",
                "x64-osx"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Debug macOS x64 LLVM",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "debug-macos-x64-llvm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Debug macOS x64 LLVM",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "build-debug-macos-x64-llvm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Bootstrap Debug macOS x64 LLVM",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Vcpkg Install macOS x64 LLVM",
                "Configure Debug macOS x64 LLVM",
                "Build Debug macOS x64 LLVM"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Unit Tests macOS x64 LLVM",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/debug-macos-x64-llvm",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build And Test Debug macOS x64 LLVM",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug macOS x64 LLVM",
                "Run Unit Tests macOS x64 LLVM"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${command:cmake.buildDirectory}",
                "-C",
                "Debug",
                "--output-on-failure"
            ],
            "osx": {
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/debug-macos-arm64-llvm",
                    "--output-on-failure"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run World Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${command:cmake.buildDirectory}",
                "-C",
                "Debug",
                "--output-on-failure",
                "-R",
                "^WorldTests$"
            ],
            "osx": {
                "args": [
                    "--test-dir",
                    "${workspaceFolder}/build/debug-macos-arm64-llvm",
                    "--output-on-failure",
                    "-R",
                    "^WorldTests$"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build And Test Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug",
                "Run Unit Tests"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
