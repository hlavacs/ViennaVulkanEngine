{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vcpkg Install",
            "type": "shell",
            "command": "vcpkg",
            "args": [
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Debug",
            "type": "shell",
            "command": "cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "windows": {
                "args": [
                    "--preset",
                    "debug-windows"
                ]
            },
            "linux": {
                "args": [
                    "--preset",
                    "debug-linux"
                ]
            },
            "osx": {
                "args": [
                    "--preset",
                    "debug-macos"
                ]
            }
        },
        {
            "label": "Bootstrap Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Vcpkg Install",
                "Configure Debug",
                "Build Debug"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-windows"
                ]
            },
            "linux": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-linux"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "build-debug-macos"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "-C",
                "Debug",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build And Test Debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug",
                "Run Unit Tests"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
