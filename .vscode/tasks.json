{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vcpkg Install Host",
            "type": "shell",
            "command": "vcpkg",
            "args": [
                "install",
                "--triplet",
                "x64-linux"
            ],
            "osx": {
                "args": [
                    "install",
                    "--triplet",
                    "arm64-osx"
                ]
            },
            "windows": {
                "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command",
                    "$vcpkg = if ($env:VCPKG_ROOT -and (Test-Path (Join-Path $env:VCPKG_ROOT 'vcpkg.exe'))) { Join-Path $env:VCPKG_ROOT 'vcpkg.exe' } elseif (Test-Path 'C:\\vcpkg\\vcpkg.exe') { 'C:\\vcpkg\\vcpkg.exe' } else { 'vcpkg' }; & $vcpkg install --triplet x64-windows; exit $LASTEXITCODE"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Mac Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install Host"
            ],
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/vscode-Debug",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/toolchains/macos-arm64-homebrew-llvm.cmake",
                "-DVVE_DEFAULT_VULKAN_ICD=moltenvk",
                "-DVVE_VCPKG_TRIPLET=arm64-osx",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Configure Mac Release",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install Host"
            ],
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/vscode-Release",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/toolchains/macos-arm64-homebrew-llvm.cmake",
                "-DVVE_DEFAULT_VULKAN_ICD=moltenvk",
                "-DVVE_VCPKG_TRIPLET=arm64-osx",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Configure Windows Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install Host"
            ],
            "args": [
                "--preset",
                "debug-windows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Configure Windows Release",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install Host"
            ],
            "args": [
                "--preset",
                "release-windows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Configure Linux Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install Host"
            ],
            "args": [
                "--preset",
                "debug-linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Configure Linux Release",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Vcpkg Install Host"
            ],
            "args": [
                "--preset",
                "release-linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Mac Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Mac Debug"
            ],
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode-Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Mac Release",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Mac Release"
            ],
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode-Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Windows Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Windows Debug"
            ],
            "args": [
                "--build",
                "--preset",
                "build-debug-windows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Windows Release",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Windows Release"
            ],
            "args": [
                "--build",
                "--preset",
                "build-release-windows"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Linux Debug",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Linux Debug"
            ],
            "args": [
                "--build",
                "--preset",
                "build-debug-linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Linux Release",
            "type": "shell",
            "command": "cmake",
            "dependsOn": [
                "Configure Linux Release"
            ],
            "args": [
                "--build",
                "--preset",
                "build-release-linux"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
