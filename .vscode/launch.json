{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "game",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/${input:variant}/exe/game",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build ${input:platform} ${input:variant}",
            "osx": {
                "MIMode": "lldb",
                "environment": [
                    {
                        "name": "VK_ICD_FILENAMES",
                        "value": "${workspaceFolder}/build/vscode-${input:variant}/vulkan/icd.d/libkosmickrisp_icd.json"
                    }
                ]
            },
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}\\bin\\${input:variant}\\exe\\game.exe",
                "environment": [],
                "console": "integratedTerminal"
            }
        },
