        {
            "name": "Run all tests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${env:ProgramFiles}/CMake/bin/ctest.exe",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/debug-windows",
                "-C",
                "Debug",
                "--output-on-failure"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Debug",
            "noDebug": true
        },
        {
            "name": "Run WorldTests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${env:ProgramFiles}/CMake/bin/ctest.exe",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/debug-windows",
                "-C",
                "Debug",
                "--output-on-failure",
                "-R",
                "^WorldTests$"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Debug",
            "noDebug": true
        },
        {
            "name": "Run all tests (macOS x64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/local/bin/ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/debug-macos-x64-llvm",
