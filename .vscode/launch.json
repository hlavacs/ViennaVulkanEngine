            }
        },
        {
            "name": "all tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "/bin/sh",
            "args": [
                "${workspaceFolder}/tools/vscode/run-ctest.sh",
                "${input:platform}",
                "${input:variant}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build ${input:platform} ${input:variant}",
            "noDebug": true,
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "type": "cppvsdbg",
                "program": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\tools\\vscode\\run-ctest.ps1",
                    "-Platform",
                    "${input:platform}",
                    "-Variant",
                    "${input:variant}"
                ],
                "console": "integratedTerminal"
            }
        }
    ],
    "inputs": [
        {
            "id": "platform",
            "type": "pickString",
            "description": "Select platform",
            "options": [
                "Mac",
                "Windows",
                "Linux"
            ],
            "default": "Mac"
        },
        {
            "id": "variant",
            "type": "pickString",
            "description": "Select build variant",
            "options": [
                "debug",
                "release"
            ],
            "default": "debug"
        }
    ]
}
